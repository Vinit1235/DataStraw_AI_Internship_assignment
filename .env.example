# Runtime connection: Supabase shared pooler, TRANSACTION mode, port 6543.
# On Vercel, append ?workaround=supabase-pooler.vercel to the URL.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@POOLER-HOST:6543/postgres?workaround=supabase-pooler.vercel"

# Admin connection: Supabase shared pooler, SESSION mode, port 5432.
# Used only by scripts/migrate.ts and scripts/seed.ts, which run from your machine.
DATABASE_ADMIN_URL="postgresql://postgres.PROJECTREF:PASSWORD@POOLER-HOST:5432/postgres"

# Local development
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roster"
# DATABASE_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/roster"

# ---------------------------------------------------------------------------
# The app runs with NO DATABASE_URL at all: it then boots PostgreSQL in-process
# (PGlite — Postgres compiled to WebAssembly), applies db/schema.sql, seeds the
# sample dataset and serves it. That is how the public demo works.
#
# Set DATABASE_URL to use a managed Postgres instead. Same SQL, same schema,
# no code change.
# ---------------------------------------------------------------------------

# Where PGlite keeps its data when no external database is configured.
# Bump this to discard a stale copy.
# PGLITE_DATA_DIR=/tmp/roster-pgdata
